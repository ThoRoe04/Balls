public class Vector2d {
    double xPos;
    double yPos;
      public Vector2d(double xPos,double yPos){
          this.xPos = xPos;
          this.yPos = yPos;
      }
    public double betrag(Vector2d vector1) {
        double geschwindigkeit = Math.sqrt((vector1.xPos * vector1.xPos) + (vector1.yPos * vector1.yPos));
        return geschwindigkeit;
    }
    public void add(Vector2d vector2){
          xPos += vector2.xPos;
          yPos += vector2.yPos;
    }
    public Vector2d normalVector(Vector2d vector1, Vector2d vector2){
          double distancePosx;
          double distancePosy;
          distancePosx = vector1.xPos - vector2.xPos;
          distancePosy = vector1.yPos - vector2.yPos;
        return new Vector2d(distancePosx,distancePosy);
    }
    public Vector2d unitVector(Vector2d vector1){
        double unitvectorxPos;
        double unitvectoryPos;
        unitvectorxPos = vector1.xPos / betrag(vector1);
        unitvectoryPos = vector1.yPos / betrag(vector1);
          return new Vector2d(unitvectorxPos, unitvectoryPos);
    }
    public Vector2d unitTangentVector(Vector2d unitVector){
          double uTanx;
          double uTany;
          uTanx = unitVector.yPos *= -1;
          uTany = unitVector.xPos;
          return new Vector2d(uTanx,uTany);
    }
    public double normalVelocity(FlyingObject object1, Vector2d vector1, Vector2d vector2){
        Vector2d unitNormalVector = unitVector(normalVector(vector1,vector2));
        double nvx;
        double nvy;
        double nv;
        nvx = unitNormalVector.xPos * object1.velocityVector.xPos;
        nvy = unitNormalVector.yPos * object1.velocityVector.yPos;
        nv = nvx + nvy;
          return nv;
    }
    public double tangentialVelocity(FlyingObject object1, Vector2d vector1, Vector2d vector2){
        Vector2d unitTangentVector = unitTangentVector(unitVector(normalVector(vector1,vector2)));
        double tvx;
        double tvy;
        double tv;
        tvx = unitTangentVector.xPos * object1.velocityVector.xPos;
        tvy = unitTangentVector.yPos * object1.velocityVector.yPos;
        tv = tvx + tvy;
        return tv;
    }
    public Vector2d normalVelocityVectorafterCollision(FlyingObject object1, FlyingObject object2, Vector2d vector1, Vector2d vector2){
          double nvac;
          double nvvacx;
          double nvvacy;
          nvac = (normalVelocity(object1, vector1, vector2) * (object1.weight - object2.weight) + 2 * object2.weight * normalVelocity(object2, vector2, vector1)) / object1.weight + object2.weight;
          nvvacx = unitVector(normalVector(vector1,vector2)).xPos * nvac;
          nvvacy = unitVector(normalVector(vector1,vector2)).yPos * nvac;
          return new Vector2d(nvvacx, nvvacy);
    }

    public Vector2d tangentialVelocityVectorafterCollision(FlyingObject object1, FlyingObject object2, Vector2d vector1, Vector2d vector2){
        double tvvacx;
        double tvvacy;
        tvvacx = unitTangentVector(unitVector(normalVector(vector1,vector2))).xPos * tangentialVelocity(object1,vector1,vector2);
        tvvacy = unitTangentVector(unitVector(normalVector(vector1,vector2))).yPos * tangentialVelocity(object1,vector1,vector2);
        return new Vector2d(tvvacx, tvvacy);
    }
    public Vector2d velocityVectorafterCollision(FlyingObject object1, FlyingObject object2, Vector2d vector1, Vector2d vector2){
     double vacx;
     double vacy;
     vacx = normalVelocityVectorafterCollision(object1, object2, vector1, vector2).xPos + tangentialVelocityVectorafterCollision(object1,object2,vector1,vector2).xPos;
     vacy = normalVelocityVectorafterCollision(object1, object2, vector1, vector2).yPos + tangentialVelocityVectorafterCollision(object1,object2,vector1,vector2).yPos;
     return new Vector2d(vacx,vacy);
    }
