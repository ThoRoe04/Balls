import java.awt.*;

public class FlyingObject {
    public Vector2d originVector;
    public Vector2d velocityVector;
    public double xStart;
    public double yStart;
    public double xSpeed;
    public double ySpeed;
    public int size;
    public Color rgb;
    public int teamselect;
    public int weight;
    public FlyingObject(double xStart, double yStart, double xSpeed, double ySpeed,int size, Color rgb, int teamselect, int weight) {
        this.originVector = new Vector2d(xStart,yStart);
        this.velocityVector = new Vector2d(xSpeed, ySpeed);
        this.xStart = xStart;
        this.yStart = yStart;
        this.xSpeed = xSpeed;
        this.ySpeed = ySpeed;
        this.size = size;
        this.rgb = rgb;
        this.teamselect = teamselect;
        this.weight = weight;

        if (teamselect == 1){
            this.rgb = Color.red;
        }
        if (teamselect == 2){
            this.rgb = Color.blue;
        }
        if (teamselect == 3){
            this.rgb = Color.green;
        }
    }

    public void nextIt(int boundFieldWidth, int boundFieldHeight){
        if(xStart >= boundFieldWidth) {
            xStart = 1-size;
        }
        if(yStart >= boundFieldHeight) {
            yStart = -size;
        }
        if(xStart + size <= 0) {
            xStart = boundFieldWidth -1;
        }
        if(yStart + size<= -size-1) {
            yStart = boundFieldHeight -1;
        }
        xStart += xSpeed;
        yStart += ySpeed;
    }
        public void draw(Graphics2D g2d){
        g2d.setColor(rgb);
        g2d.fillOval((int) xStart,(int) yStart,size, size);
