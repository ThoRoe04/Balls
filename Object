   public void rps (FlyingObject object){
        if (teamselect == 1 && object.teamselect == 2){
            object.teamselect = 1;
            object.rgb = Color.red;
        } else if (teamselect == 2 && object.teamselect == 3) {
            object.teamselect = 2;
            object.rgb = Color.blue;
        } else if (teamselect == 3 && object.teamselect == 1) {
            object.teamselect =3;
            object.rgb = Color.green;
        }
        else if (teamselect == 1 && object.teamselect == 3){
            teamselect = 3;
            rgb = Color.green;
        } else if (teamselect == 2 && object.teamselect == 1) {
            teamselect = 1;
            object.rgb = Color.red;
        } else if (teamselect == 3 && object.teamselect == 2) {
            teamselect =2;
            object.rgb = Color.blue;
        }
    }
    public boolean collid(FlyingObject object){
        if(object == null || object == this){
            return false;
        }
        double distance = distance(object);
        return distance <= (size / 2.) + (object.size / 2.);
    }
    public double distance(FlyingObject object) {
        double xDif = (xStart+ (size / 2.)) - (object.xStart+ (object.size / 2.));
        double yDif = (yStart+(size / 2.)) - (object.yStart+ (object.size / 2.));
        double distancesquared = xDif * xDif + yDif * yDif;
        return Math.sqrt(distancesquared);
    }
    public void reverseSpeed(){
            xSpeed *= -1;
            ySpeed *= -1;
           // size -= 1;
    }
}
